SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=saferoad_db
DB_USER=saferoad_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Vite prend le premier port libre à partir de 5173 : si un autre process occupe déjà
# 5173 sur votre machine, il basculera sur 5174/5175/... — la liste ci-dessous couvre ce cas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# Hors DEBUG uniquement — domaines autorisés à soumettre des requêtes protégées par CSRF.
CSRF_TRUSTED_ORIGINS=

# Mot de passe des comptes de démo créés par `manage.py creer_comptes_demo`.
# Laisser vide : un mot de passe aléatoire est généré et affiché une seule fois.
DJANGO_DEMO_PASSWORD=

# Page du frontend où mènent les liens d'invitation / de mot de passe oublié.
FRONTEND_URL=http://localhost:5173
# E-mails : laisser vide pour les afficher dans le terminal du serveur (développement).
# Envoi réel (ex. Gmail avec un mot de passe d'application) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=SafeRoad <adresse@exemple.sn>

# SMS d'urgence (choc critique). Laisser vide : les SMS s'affichent dans le terminal du serveur.
# SMS_BACKEND=orange
# ORANGE_SMS_CLIENT_ID=
# ORANGE_SMS_CLIENT_SECRET=
# ORANGE_SMS_EXPEDITEUR=+221770000000
